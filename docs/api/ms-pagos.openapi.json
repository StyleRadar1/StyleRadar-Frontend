{
  "openapi": "3.0.1",
  "info": {
    "title": "StyleRadar · ms-payments-subscriptions",
    "description": "Payments y subscriptions de StyleRadar (SR-RF-67, 68, 75, 93-103).\nPayments with Mercado Pago, HMAC webhook, Redis idempotency,\ndaily reconciliation and events in styleradar.exchange.\n",
    "contact": {
      "name": "Squad NQS · DOSW 2026"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Webhooks",
      "description": "Mercado Pago notifications"
    },
    {
      "name": "Health",
      "description": "Microservice status"
    },
    {
      "name": "Planes",
      "description": "Plan catalog and benefits"
    },
    {
      "name": "Payments",
      "description": "Payment history and retries"
    },
    {
      "name": "Administration",
      "description": "Global payment query"
    },
    {
      "name": "Subscriptions",
      "description": "Payment, query and cancellation of subscriptions"
    }
  ],
  "paths": {
    "/api/v1/webhooks/mercadopago": {
      "post": {
        "tags": [
          "Webhooks"
        ],
        "summary": "Receive and process a Mercado Pago notification",
        "operationId": "receive",
        "parameters": [
          {
            "name": "x-signature",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-request-id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "topic",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "data.id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JsonNode"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/subscriptions/{subscriberId}/cancel": {
      "post": {
        "tags": [
          "Subscriptions"
        ],
        "summary": "Cancel automatic renewal while keeping the paid period",
        "operationId": "cancel",
        "parameters": [
          {
            "name": "subscriberId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-User-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-User-Role",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CancelSubscriptionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CancellationResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/subscriptions/start": {
      "post": {
        "tags": [
          "Subscriptions"
        ],
        "summary": "Start a subscription payment and return the Mercado Pago link",
        "operationId": "start",
        "parameters": [
          {
            "name": "X-User-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartSubscriptionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/StartSubscriptionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/payments/{orderId}/retry": {
      "post": {
        "tags": [
          "Payments"
        ],
        "summary": "Create a new payment attempt for a rejected order",
        "operationId": "retry",
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "X-User-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RetryPaymentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/RetryPaymentResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/subscriptions/{subscriberId}": {
      "get": {
        "tags": [
          "Subscriptions"
        ],
        "summary": "Get the status, validity and plan of a subscription",
        "operationId": "get",
        "parameters": [
          {
            "name": "subscriberId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-User-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-User-Role",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/SubscriptionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/plans": {
      "get": {
        "tags": [
          "Planes"
        ],
        "summary": "List active plans with their price and limits",
        "operationId": "list",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PlanResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/payments/history": {
      "get": {
        "tags": [
          "Payments"
        ],
        "summary": "Get the authenticated user's payment history",
        "operationId": "history",
        "parameters": [
          {
            "name": "X-User-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PaymentResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Check that the microservice is up",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/payments": {
      "get": {
        "tags": [
          "Administration"
        ],
        "summary": "List all payments, with an optional status filter",
        "operationId": "list_1",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "PENDING",
                "APPROVED",
                "REJECTED"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PaymentResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/payments/{id}": {
      "get": {
        "tags": [
          "Administration"
        ],
        "summary": "Get a payment by id",
        "operationId": "get_1",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "JsonNode": {
        "type": "object"
      },
      "CancelSubscriptionRequest": {
        "required": [
          "confirmed"
        ],
        "type": "object",
        "properties": {
          "confirmed": {
            "type": "boolean"
          }
        }
      },
      "CancellationResponse": {
        "type": "object",
        "properties": {
          "subscriptionId": {
            "type": "integer",
            "format": "int64"
          },
          "autoRenewal": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "ACTIVE",
              "SUSPENDED"
            ]
          },
          "endDate": {
            "type": "string",
            "format": "date"
          },
          "cancellationConfirmed": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "StartSubscriptionRequest": {
        "required": [
          "payerEmail",
          "subscriberType"
        ],
        "type": "object",
        "properties": {
          "subscriberType": {
            "type": "string",
            "enum": [
              "USER",
              "STORE"
            ]
          },
          "payerEmail": {
            "type": "string"
          },
          "planId": {
            "type": "integer",
            "format": "int64"
          },
          "taxId": {
            "pattern": "\\d{9}",
            "type": "string"
          },
          "storeId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "StartSubscriptionResponse": {
        "type": "object",
        "properties": {
          "subscriptionId": {
            "type": "integer",
            "format": "int64"
          },
          "orderId": {
            "type": "integer",
            "format": "int64"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "ACTIVE",
              "SUSPENDED"
            ]
          },
          "initPoint": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "RetryPaymentRequest": {
        "required": [
          "payerEmail"
        ],
        "type": "object",
        "properties": {
          "payerEmail": {
            "type": "string"
          }
        }
      },
      "RetryPaymentResponse": {
        "type": "object",
        "properties": {
          "orderId": {
            "type": "integer",
            "format": "int64"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "APPROVED",
              "REJECTED"
            ]
          },
          "initPoint": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "AmountResponse": {
        "type": "object",
        "properties": {
          "value": {
            "type": "number"
          },
          "currency": {
            "type": "string"
          }
        }
      },
      "PlanResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "subscriberType": {
            "type": "string",
            "enum": [
              "USER",
              "STORE"
            ]
          },
          "price": {
            "$ref": "#/components/schemas/AmountResponse"
          },
          "limits": {
            "type": "object",
            "additionalProperties": {
              "type": "object"
            }
          },
          "active": {
            "type": "boolean"
          }
        }
      },
      "SubscriptionResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "subscriberId": {
            "type": "string"
          },
          "subscriberType": {
            "type": "string",
            "enum": [
              "USER",
              "STORE"
            ]
          },
          "plan": {
            "$ref": "#/components/schemas/PlanResponse"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "ACTIVE",
              "SUSPENDED"
            ]
          },
          "startDate": {
            "type": "string",
            "format": "date"
          },
          "endDate": {
            "type": "string",
            "format": "date"
          },
          "autoRenewal": {
            "type": "boolean"
          },
          "access": {
            "type": "boolean"
          },
          "taxId": {
            "type": "string"
          },
          "storeId": {
            "type": "string",
            "format": "uuid"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "PaymentResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "subscriptionId": {
            "type": "integer",
            "format": "int64"
          },
          "subscriberId": {
            "type": "string"
          },
          "planId": {
            "type": "integer",
            "format": "int64"
          },
          "planName": {
            "type": "string"
          },
          "amount": {
            "$ref": "#/components/schemas/AmountResponse"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "APPROVED",
              "REJECTED"
            ]
          },
          "externalPaymentId": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
