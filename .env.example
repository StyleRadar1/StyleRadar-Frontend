# Ambiente local de desarrollo. En QA y producción configurar estas variables
# en el proveedor de despliegue con la URL del API Gateway correspondiente.
VITE_APP_ENV=local
VITE_API_URL=http://localhost:8080
# true: los servicios responden con datos de prueba mientras el backend no esté listo.
VITE_USE_MOCKS=true
# Token público de Mapbox (pk.). Necesario para el mapa interactivo.
# Mapbox: pega aquí el token PÚBLICO (empieza por pk.). Nunca uses uno secreto (sk.).
# Restríngelo por URL en account.mapbox.com para que solo funcione en nuestros dominios.
VITE_MAPBOX_TOKEN=pk.eyJ1IjoicGlwZS1tb3JhbGVzejA3IiwiYSI6ImNtdzZreG8weDBsNGsyem9vMzR6ZmF5NHUifQ.V-DQc6fG9xtSM4XBOL93-A
