# URL del API Gateway (sr-api-gateway). Cada ambiente define la suya.
VITE_API_URL=http://localhost:8080
# true: los servicios responden con datos de prueba mientras el backend no esté listo.
VITE_USE_MOCKS=true
# Token público de Mapbox (pk.). Necesario para el mapa interactivo.
VITE_MAPBOX_TOKEN=
