# Ambiente local de desarrollo. En QA y producción configurar estas variables
# en el proveedor de despliegue con la URL del API Gateway correspondiente.
VITE_APP_ENV=local
VITE_API_URL=http://localhost:8080
# true: los servicios responden con datos de prueba mientras el backend no esté listo.
VITE_USE_MOCKS=true
